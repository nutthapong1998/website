# Copy to .env.local and fill in — see README "Environment variables"

# ── Public (compiled into the JS bundle — safe to expose) ──
# Canonical site URL, used for metadata/sitemap. Local dev can leave unset.
NEXT_PUBLIC_SITE_URL=

# ── Server-only (NEVER prefix these with NEXT_PUBLIC_) ──
# Must match the Cloudflare Transform Rule header value (production only).
ORIGIN_AUTH_SECRET=
